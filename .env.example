# Root env reference. The API reads env from apps/api/.env during local development:
#
#   cp .env.example apps/api/.env
#
# Site content does not come from env or a database — edit apps/web/src/content/epk.ts.

PORT=3001

# Comma-separated list of allowed frontend origins for CORS. Leave unset to allow any origin.
ALLOWED_ORIGIN=

# Optional. Only needed once an API route imports apps/api/src/db.
DATABASE_URL=postgresql://postgres:password@localhost:5432/epk_db

# Third-party integration keys go here.
