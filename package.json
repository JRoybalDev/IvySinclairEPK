{
  "name": "epk-template-v1",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:web": "bun run --filter web dev",
    "dev:api": "bun run --filter api dev",
    "build": "bun run --filter web build",
    "lint": "bun run --filter '*' lint",
    "validate:content": "bun run scripts/validate-content.ts"
  },
  "dependencies": {
    "hono": "^4.12.22"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
