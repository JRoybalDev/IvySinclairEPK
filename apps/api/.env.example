PORT=3001

# Comma-separated list of allowed frontend origins for CORS, e.g.
# https://example-artist.com,https://staging.example-artist.com
# Leave unset to allow any origin.
ALLOWED_ORIGIN=

# Optional. Only needed once a route imports src/db.
DATABASE_URL=postgresql://postgres:password@localhost:5432/epk_db

# Third-party integration keys go here, e.g.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
